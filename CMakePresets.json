{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-windows-vcpkg",
      "displayName": "Visual Studio 2026 x64 (vcpkg)",
      "description": "Requires VCPKG_ROOT to name a vcpkg installation.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/native/vs2026",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
		"CLIPBOARD_BUILD_TESTS": "ON",
        "CLIPBOARD_STAGE_DIR": "${sourceDir}/build/stage/native"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026-windows-vcpkg",
      "configuration": "Release"
    }
  ]
}
