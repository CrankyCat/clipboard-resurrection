{
  "modName": "Clipboard",
  "displayName": "Clipboard",
  "minMcmVersion": 1,
  "content": [
    {
      "text": "<p align='center'><font size='28'>Clipboard</font></p>",
      "type": "text",
      "html": true
    },
    {
      "text": "Dialogs",
      "type": "section"
    },
    {
      "id": "bEnableActionFinishedDialogs:Dialogs",
      "text": "Show Notification When An Action Is Complete",
      "type": "switcher",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bEnableActionFinishedDialogs:Dialogs",
          "{value}"
        ]
      }
    },
    {
      "id": "bEnableManualMethodDialog:Dialogs",
      "text": "Show Description When Manual Method Is Activated",
      "type": "switcher",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bEnableManualMethodDialog:Dialogs",
          "{value}"
        ]
      }
    },
    {
      "id": "bHideConditionBoyDuringInput:Dialogs",
      "text": "Hide Condition Boy/Girl During Input",
      "type": "switcher",
      "help": "Default on. Hides Condition Boy/Girl while a Clipboard input dialog is open. Has no effect when the mod is absent.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bHideConditionBoyDuringInput:Dialogs",
          "{value}"
        ]
      }
    },
    {
      "id": "iWorkshopModeOnAction:Dialogs",
      "text": "Enter Workshop Mode Upon Starting Certain Actions",
      "type": "stepper",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "options": [
          "Never",
          "Ask",
          "Always"
        ]
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingInt",
        "params": [
          "Clipboard",
          "iWorkshopModeOnAction:Dialogs",
          "{value}"
        ]
      }
    },
    {
      "text": "Balance",
      "type": "section"
    },
    {
      "id": "bEnableComponentCost:Balance",
      "text": "Charge Components When Pasting",
      "type": "switcher",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bEnableComponentCost:Balance",
          "{value}"
        ]
      }
    },
    {
      "text": "Selection",
      "type": "section"
    },
    {
      "id": "iInitialSelectionMethod:Selection",
      "text": "The Initial Selection Method",
      "type": "stepper",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "options": [
          "Sphere",
          "Cylinder",
          "Box",
          "Manual",
          "Select All",
          "Select By Plugin",
          "Select By Cell"
        ]
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingInt",
        "params": [
          "Clipboard",
          "iInitialSelectionMethod:Selection",
          "{value}"
        ]
      }
    },
    {
      "id": "iEffectIndex:Selection",
      "text": "The Visual Effect Used On Selected Objects",
      "type": "stepper",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "options": [
          "Classic",
          "White",
          "Red",
          "Blue",
          "Yellow"
        ]
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingInt",
        "params": [
          "Clipboard",
          "iEffectIndex:Selection",
          "{value}"
        ]
      }
    },
    {
      "id": "bEnableAnimalSelection:Selection",
      "text": "Allow Animals To Be Selected",
      "type": "switcher",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bEnableAnimalSelection:Selection",
          "{value}"
        ]
      }
    },
    {
      "id": "bAllowNormallyFilteredObjectsToBeSelectedAndExported:Selection",
      "text": "Allow Normally Filtered Objects To Be Selected And Exported",
      "type": "switcher",
      "help": "Default off. Broadens automatic selection to otherwise eligible non-player objects and filtered lights. Manually selected objects are exported regardless of this option; permanent exclusions still apply.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bAllowNormallyFilteredObjectsToBeSelectedAndExported:Selection",
          "{value}"
        ]
      }
    },
    {
      "text": "Import Options",
      "type": "section"
    },
    {
      "id": "bAllowAllObjectsToBeImported:Selection",
      "text": "Allow normally filtered light sources to be imported",
      "type": "switcher",
      "help": "Default off. Setting to on allows light sources which can't be manipulated by the player in build mode and those without a construction recipe to be imported.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bAllowAllObjectsToBeImported:Selection",
          "{value}"
        ]
      }
    },
    {
      "id": "bDisableHavokOnImportedObjects:Balance",
      "text": "Disable Havok Physics On Imported Objects",
      "type": "switcher",
      "help": "Default on. Sets each imported non-actor to keyframed motion as soon as its 3D loads, preventing loose objects such as bottles and weapons from falling or rolling. Scripted, animated, inventory, and workshop operations may still move or change an object.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bDisableHavokOnImportedObjects:Balance",
          "{value}"
        ]
      }
    },
    {
      "id": "bUseThrottling:Import",
      "text": "Use Throttling",
      "type": "switcher",
      "help": "Default on. Limits simultaneous workshop initialization calls during import. Turning this off may cause scripting overloads and Papyrus stack dumps that can interfere with other mods such as Sim Settlements 2. Applies to the next import.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bUseThrottling:Import",
          "{value}"
        ]
      }
    },
    {
      "text": "Hotkeys",
      "type": "section"
    },
    {
      "id": "activateActionQuickBtn",
      "text": "Show Quick Menu",
      "type": "hotkey",
      "help": "Quick menu provides access to all of a tool's buttons. Suggested Key: P"
    },
    {
      "id": "activateActionMenuBtn",
      "text": "Show Action Menu",
      "type": "hotkey",
      "help": "Access a tool's Action Menu from workshop mode or well away from the tool. Suggested Key: L"
    },
    {
      "id": "activateSelectionMethodBtn",
      "text": "Change Selection Method",
      "type": "hotkey",
      "help": "Access a tool's Method Selection from workshop mode or well away from the tool. Suggested Key: ;"
    },
    {
      "id": "activateSelectionScanBtn",
      "text": "Initiate Selection Method's Secondary Action",
      "type": "hotkey",
      "help": "Toggle Select/Deselect, Initiate Selection Scan, etc... Suggested: '"
    },
    {
      "id": "activateClearSelectionBtn",
      "text": "Clear Selection",
      "type": "hotkey",
      "help": "Clear selection from workshop mode or well away from the tool. Suggested Key: ["
    },
    {
      "id": "activateDestroyToolBtn",
      "text": "Destroy Tool",
      "type": "hotkey",
      "help": "Destroy a tool from workshop mode or well away from the tool. Suggested Key: ]"
    },
    {
      "text": "Debug",
      "type": "section"
    },
    {
      "id": "bDisplayImportWarnings:Debug",
      "text": "Display Import Warnings",
      "type": "switcher",
      "help": "Show import warnings in the completion dialog. Default: Off. Warning logging is unaffected.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallGlobalFunction",
        "script": "MCM",
        "function": "SetModSettingBool",
        "params": [
          "Clipboard",
          "bDisplayImportWarnings:Debug",
          "{value}"
        ]
      }
    },
    {
      "id": "bEnableLogging:Debug",
      "text": "Enable Diagnostic Logging",
      "type": "switcher",
      "help": "Enable additional diagnostic logging. Warnings and errors are always logged. Log: Documents\\My Games\\Fallout4\\F4SE\\Clipboard.log",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      },
      "action": {
        "type": "CallFunction",
        "form": "Clipboard.esp|3790b",
        "function": "SetDebugLogging",
        "params": [
          "{value}"
        ]
      }
    },
    {
      "id": "cleanUpOldPlatforms",
      "text": "Clean Up Old Platforms",
      "type": "button",
      "help": "Remove remnants of destroyed Clipboard platforms. First destroy all remaining platforms and make a backup save. Close the menus to continue.",
      "action": {
        "type": "CallFunction",
        "form": "Clipboard.esp|3790b",
        "function": "CleanUpOldPlatforms"
      }
    }
  ]
}
