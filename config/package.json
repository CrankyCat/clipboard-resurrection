        "MCM/Config/Clipboard/config.json", "MCM/Config/Clipboard/keybinds.json", "MCM/Config/Clipboard/settings.ini",
        "MCM/Settings/Clipboard.ini", "MCM/Settings/Keybinds.json", "MCM/Settings/readme.txt"
      ]
    },
    {
      "source": "docs/user/en", "destination": "Docs/clipboard",
      "files": ["Clipboard-ReadMe.txt", "Clipboard-Object-Filtering.txt", "Clipboard-Localization.txt", "CHANGELOG.txt"]
    },
    {"source": "build/generated/localization", "destination": ""},
    {"source": "build/generated/ui", "destination": "", "files": ["Interface/ClipboardInput.swf"]},
    {"source": "src/papyrus", "destination": "Scripts/Source/User", "extension": ".psc", "count": 16},
    {"source": "build/papyrus/current/Scripts", "destination": "Scripts", "extension": ".pex", "count": 16}
