  ],
  "dependencyNotices": {
    "source": "build/native/vs2026/vcpkg_installed/x64-windows-static-md/share",
    "destination": "Docs/clipboard/Licenses",
    "packages": ["boost-assert", "boost-cmake", "boost-config", "boost-headers", "boost-stl-interfaces", "boost-type-traits", "fmt", "rsm-mmio", "spdlog", "zycore", "zydis"]
  },
  "patternSlots": {"destination": "F4SE/Plugins/Clipboard", "first": 1, "last": 500, "filename": "PLACEHOLDER"}
