# Admit only the maintained source areas at the repository root.
# New top-level content requires an explicit publication review.
/*
!/.gitattributes
!/.gitignore
!/LICENSE.txt
!/README.md
!/Scripts/
!/UI/
!/external/
!/localization/
!/native/
!/package/
!/tools/

# Keep maintained scripts and reusable diagnostic source, not game imports.
/Scripts/*
!/Scripts/Source/
/Scripts/Source/*
!/Scripts/Source/User/
!/Scripts/Source/Diagnostics/
/UI/*
!/UI/ClipboardInput/

# F4SE is fetched locally. Only its pin and instructions belong in Git.
/external/*
!/external/CommonLibF4RD/
!/external/F4SE/
/external/F4SE/*
!/external/F4SE/README.md
!/external/F4SE/current-reference.json

